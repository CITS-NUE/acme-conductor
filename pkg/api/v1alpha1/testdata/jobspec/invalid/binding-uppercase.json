{
  "apiVersion": "acme-conductor.cits-nue.github.io/v1alpha1",
  "kind": "CertificateReconcileJob",
  "runId": "01JABCDEFGHJKMNPQRSTVWXYZ0",
  "target": {
    "id": "01JABCDEFGHJKMNPQRSTVWXYZ1",
    "fqdn": "wiki.example.ac.jp",
    "revision": 3
  },
  "policy": {
    "allowedDnsSuffixes": [
      "example.ac.jp"
    ],
    "allowWildcard": false,
    "renewBeforeDays": 30,
    "keyType": "ec256"
  },
  "acme": {
    "binding": "LetsEncrypt-Staging"
  },
  "dns": {
    "binding": "azure-dns-staging"
  },
  "store": {
    "binding": "filesystem-dev"
  }
}

#
# Dockerfile.runner builds the ACME Runner data-plane binary
# (cmd/acme-runner) as a minimal, non-root, distroless runtime image.
#
# Build:
#   docker build -f Dockerfile.runner \
#     --build-arg VERSION=$(git describe --tags --always --dirty) \
#     --build-arg COMMIT=$(git rev-parse --short HEAD) \
#     --build-arg BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ) \
#     -t ghcr.io/cits-nue/acme-runner:dev .

# --- builder -----------------------------------------------------------
#
# Pinned by tag for Phase 0. Release builds pin the base image by digest
# (golang:1.25-bookworm@sha256:<digest>) instead of by mutable tag; that
# pinning is done at release time, not here.
FROM golang:1.25-bookworm AS builder

WORKDIR /src

# Copy go.mod (and go.sum, if present) first so the module download layer
# is cached independently of source changes. go.sum may not exist yet on a
# freshly initialized module, so the glob form is used rather than a plain
# COPY go.mod go.sum which would fail if go.sum is missing.
COPY go.mod go.su[m] ./
RUN go mod download

# Now copy the rest of the source tree and build.
COPY . .

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown

ENV CGO_ENABLED=0

RUN go build \
    -trimpath \
    -ldflags "-s -w \
      -X github.com/CITS-NUE/acme-conductor/internal/version.Version=${VERSION} \
      -X github.com/CITS-NUE/acme-conductor/internal/version.Commit=${COMMIT} \
      -X github.com/CITS-NUE/acme-conductor/internal/version.Date=${BUILD_DATE}" \
    -o /out/acme-runner \
    ./cmd/acme-runner

# --- lego ----------------------------------------------------------------
#
# Fetches the official, pre-built `lego` ACME client binary from its
# GitHub release artifact and verifies it against a pinned sha256 checksum
# before it is ever extracted or run. It is not built from source here.
#
# Bumping the lego version means updating LEGO_VERSION *and* both
# LEGO_SHA256_AMD64 / LEGO_SHA256_ARM64 below to match the new release's
# published checksums — the download is refused if the checksum does not
# match. CI (.github/workflows/ci.yml) builds this image on every push and
# PR, so a stale/incorrect checksum here fails CI, not just a local build.
#
# Reuses the golang:1.25-bookworm image as the fetch environment (it
# already has curl and tar) rather than pulling in another base image.
FROM golang:1.25-bookworm AS lego

ARG LEGO_VERSION=4.35.2
ARG LEGO_SHA256_AMD64=ee5be4bf457de8e3efa86a51651c75c87f0ee0e4e9f3ae14f6034d68365770f3
ARG LEGO_SHA256_ARM64=e1f153179098d27ce044aaaa168c0e323d50ae71b0f1a147aa8ae49ac6b14d89
# BuildKit sets TARGETARCH automatically; default it for the legacy
# (non-BuildKit) builder, which does not populate build-time platform ARGs.
ARG TARGETARCH=amd64

WORKDIR /out

RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) lego_arch="amd64"; expected_sha256="$LEGO_SHA256_AMD64" ;; \
      arm64) lego_arch="arm64"; expected_sha256="$LEGO_SHA256_ARM64" ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    archive="lego_v${LEGO_VERSION}_linux_${lego_arch}.tar.gz"; \
    url="https://github.com/go-acme/lego/releases/download/v${LEGO_VERSION}/${archive}"; \
    curl --fail --location --proto '=https' --tlsv1.2 --output "$archive" "$url"; \
    echo "${expected_sha256}  ${archive}" | sha256sum -c -; \
    tar -xzf "$archive" lego; \
    chmod 0755 lego; \
    rm -f "$archive"

# --- runtime -------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot AS runtime

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
ARG LEGO_VERSION=4.35.2

LABEL org.opencontainers.image.source="https://github.com/CITS-NUE/acme-conductor" \
      org.opencontainers.image.title="acme-runner" \
      org.opencontainers.image.description="ACME Runner one-shot data-plane job (validates a JobSpec, drives lego, stores the certificate)." \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.acme-conductor.lego.version="${LEGO_VERSION}"

COPY --from=builder /out/acme-runner /usr/local/bin/acme-runner
COPY --from=lego /out/lego /usr/local/bin/lego

# distroless/static-debian12:nonroot already runs as uid/gid 65532
# (nonroot:nonroot); set it explicitly for clarity and to survive any base
# image change that alters the default user.
USER nonroot:nonroot

# The runner will need a writable tmpfs/emptyDir mounted at /work (scratch
# space for the ACME/lego exchange) and /state (certificate output) once
# Phase 1+ adds the actual job logic. Those are supplied by the caller at
# run time (docker run --tmpfs / Kubernetes emptyDir volumes), not baked
# into the image — so no VOLUME is declared here; a VOLUME instruction
# would create anonymous volumes on every `docker run` and is not wanted.
# The root filesystem otherwise stays read-only friendly (no writes at
# startup in Phase 0).
ENTRYPOINT ["/usr/local/bin/acme-runner"]

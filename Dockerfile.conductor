#
# Dockerfile.conductor builds the ACME Conductor control-plane binary
# (cmd/acme-conductor) as a minimal, non-root, distroless runtime image.
#
# Build:
#   docker build -f Dockerfile.conductor \
#     --build-arg VERSION=$(git describe --tags --always --dirty) \
#     --build-arg COMMIT=$(git rev-parse --short HEAD) \
#     --build-arg BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ) \
#     -t ghcr.io/cits-nue/acme-conductor:dev .

# --- builder -----------------------------------------------------------
#
# Base images are pinned by digest: the tag says what the
# digest is expected to be, the digest is what is built from. Dependabot
# (.github/dependabot.yml) proposes updates to both together.
FROM golang:1.25-bookworm@sha256:3b4a11519ad929d1e1d261a12cff056f0c85b735253d7d861346b9c6f8b36437 AS builder

WORKDIR /src

# Copy go.mod (and go.sum, if present) first so the module download layer
# is cached independently of source changes. go.sum may not exist yet on a
# freshly initialized module, so the glob form is used rather than a plain
# COPY go.mod go.sum which would fail if go.sum is missing.
COPY go.mod go.su[m] ./
RUN go mod download

# Now copy the rest of the source tree and build.
COPY . .

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown

ENV CGO_ENABLED=0

RUN go build \
    -trimpath \
    -ldflags "-s -w \
      -X github.com/CITS-NUE/acme-conductor/internal/version.Version=${VERSION} \
      -X github.com/CITS-NUE/acme-conductor/internal/version.Commit=${COMMIT} \
      -X github.com/CITS-NUE/acme-conductor/internal/version.Date=${BUILD_DATE}" \
    -o /out/acme-conductor \
    ./cmd/acme-conductor

# --- runtime -------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab AS runtime

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.source="https://github.com/CITS-NUE/acme-conductor" \
      org.opencontainers.image.title="acme-conductor" \
      org.opencontainers.image.description="ACME Conductor control plane (target registry, policy, audit, run scheduling)." \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.licenses="Apache-2.0"

COPY --from=builder /out/acme-conductor /usr/local/bin/acme-conductor

# distroless/static-debian12:nonroot already runs as uid/gid 65532
# (nonroot:nonroot); set it explicitly for clarity and to survive any base
# image change that alters the default user.
USER nonroot:nonroot

# The image writes only to the paths its configuration names, so it is
# safe to run with a read-only root filesystem (docker run --read-only /
# Kubernetes readOnlyRootFilesystem: true) as long as the registry
# directory (database.path, e.g. /var/lib/acme-conductor) is a writable,
# persistent mount and the configuration is mounted read-only at
# /etc/acme-conductor/config.json. No VOLUME is declared so that the
# caller chooses the mount explicitly. The image contains neither
# acme-runner nor lego: the local-process launcher needs both on the same
# host, while the Azure Container Apps Job launcher needs
# neither — it starts executions of a separately deployed Runner Job and
# only needs the exchange share mounted (see docs/conductor.md and
# deploy/azure/README.md). With jobSigning configured, the private key
# file is mounted read-only for this container only.
#
#   docker run --rm --read-only -p 127.0.0.1:8080:8080 \
#     -v $PWD/conductor-config.json:/etc/acme-conductor/config.json:ro \
#     -v acme-conductor-state:/var/lib/acme-conductor \
#     ghcr.io/cits-nue/acme-conductor:dev serve
ENTRYPOINT ["/usr/local/bin/acme-conductor"]

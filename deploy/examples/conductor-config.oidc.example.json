{
  "apiVersion": "acme-conductor.cits-nue.github.io/v1alpha1",
  "kind": "ConductorConfig",
  "server": {
    "listen": "0.0.0.0:8443",
    "auth": {
      "mode": "oidc",
      "oidc": {
        "issuer": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0",
        "audience": "api://acme-conductor",
        "clientId": "22222222-2222-2222-2222-222222222222",
        "scopes": ["openid", "profile", "api://acme-conductor/.default"],
        "principalClaim": "preferred_username",
        "rolesClaim": "roles",
        "roles": {
          "admin": ["ACME.Admin"],
          "viewer": ["ACME.Viewer"]
        },
        "clockSkewSeconds": 60,
        "keyCacheSeconds": 3600
      }
    },
    "tls": {
      "certFile": "/etc/acme-conductor/tls.crt",
      "keyFile": "/etc/acme-conductor/tls.key"
    },
    "shutdownGraceSeconds": 900
  },
  "database": {
    "path": "/var/lib/acme-conductor/conductor.db"
  },
  "scheduler": {
    "tickSeconds": 60,
    "maxConcurrentRuns": 2,
    "retryBackoffSeconds": 300,
    "maxRetryBackoffSeconds": 21600
  },
  "jobSigning": {
    "privateKeyFile": "/etc/acme-conductor/job-signing.pem",
    "validitySeconds": 900
  },
  "executionBindings": {
    "local": {
      "type": "local-process",
      "localProcess": {
        "runnerBinary": "/usr/local/bin/acme-runner",
        "runnerConfig": "/etc/acme-runner/config.json",
        "workDir": "/var/lib/acme-conductor/runs",
        "timeoutSeconds": 1200
      }
    }
  },
  "acmeBindings": [
    "letsencrypt-staging"
  ],
  "dnsBindings": [
    "azure-dns-staging"
  ],
  "storeBindings": [
    "filesystem-dev"
  ]
}

{
  "apiVersion": "acme-conductor.cits-nue.github.io/v1alpha1",
  "kind": "ConductorConfig",
  "server": {
    "listen": "0.0.0.0:8080",
    "auth": {
      "mode": "oidc",
      "oidc": {
        "issuer": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0",
        "audience": "11111111-1111-1111-1111-111111111111",
        "clientId": "22222222-2222-2222-2222-222222222222",
        "scopes": [
          "openid",
          "profile",
          "api://11111111-1111-1111-1111-111111111111/.default"
        ],
        "principalClaim": "oid",
        "roles": {
          "admin": [
            "ACME.Admin"
          ],
          "viewer": [
            "ACME.Viewer"
          ]
        }
      }
    },
    "behindTlsProxy": true,
    "shutdownGraceSeconds": 1800
  },
  "database": {
    "path": "/var/lib/acme-conductor/conductor.db"
  },
  "scheduler": {
    "tickSeconds": 60,
    "maxConcurrentRuns": 2,
    "retryBackoffSeconds": 300,
    "maxRetryBackoffSeconds": 21600
  },
  "jobSigning": {
    "privateKeyFile": "/etc/acme-conductor/job-signing.pem",
    "validitySeconds": 900
  },
  "resultSigning": {
    "publicKeys": [
      "MCowBQYDK2VwAyEA65N/M3oDE8dU2aAKvMDf19gGaRxk3W3gRWTKAj2DPOM="
    ]
  },
  "executionBindings": {
    "azure": {
      "type": "azure-container-apps-job",
      "config": {
        "subscriptionId": "00000000-0000-0000-0000-000000000000",
        "resourceGroup": "rg-acme",
        "jobName": "acme-runner",
        "cloud": "public",
        "credential": "managed-identity",
        "managedIdentityClientId": "11111111-1111-1111-1111-111111111111",
        "exchangeDir": "/mnt/exchange",
        "claimTimeoutSeconds": 300,
        "timeoutSeconds": 1800,
        "pollIntervalSeconds": 10,
        "resultGraceSeconds": 30
      }
    }
  },
  "acmeBindings": [
    "letsencrypt-staging"
  ],
  "dnsBindings": [
    "azure-dns-staging"
  ],
  "storeBindings": [
    "keyvault-staging"
  ]
}
